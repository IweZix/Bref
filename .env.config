NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_BACKEND_URL

# Supabase (provisioned via Vercel Marketplace, free plan, Frankfurt/fra1 region)
# Real values live in .env.local (gitignored), synced via `vercel env pull .env.local`.
# NEXT_PUBLIC_* vars are exposed to the browser — never put the service role key there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection (NOT the transaction-mode pooler) — required for running migrations.
POSTGRES_URL_NON_POOLING=

# Random secret used to derive the daily-rotating visitor hash salt (click privacy, never the rate-limit IP hash).
# Generate with: openssl rand -hex 32
VISITOR_HASH_SECRET=